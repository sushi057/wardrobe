{
  "name": "wardrobe",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node --watch server/index.js",
    "web": "npm --prefix web run dev",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run server\" \"npm run web\"",
    "adapters:install": "mkdir -p ~/.opencli/clis/gemini && cp adapters/gemini/tryon.js ~/.opencli/clis/gemini/tryon.js",
    "release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
